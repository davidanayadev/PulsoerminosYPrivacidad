---
import "../styles/global.css";
import "../styles/landing.css";
import Footer from "../components/Footer.astro";
import { appName, tagline, description, storeUrl, legalUrls } from "../data/site.js";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{appName} — {tagline}</title>
  </head>

  <body>
    <header>
      <div class="header-brand">
        <img src="/icon.png" alt={`Logotipo de ${appName}`} width="56" height="56" />
        <div class="header-text">
          <h1>{appName}</h1>
          <p>{tagline}</p>
        </div>
      </div>
    </header>

    <main class="landing">
      <section class="hero">
        <div class="hero-content fade-up">
          <img src="/pulso_logo_source.svg" alt={`Logotipo de ${appName}`} class="hero-logo surface-card" width="112" height="112" />
          <h1 class="hero-title">{appName}</h1>
          <p class="hero-tagline">{tagline}</p>
          <p class="hero-description">{description}</p>
          <a class="cta" href={storeUrl}>Descargar en la tienda</a>
          <p class="hero-note">Disponible próximamente en App Store y Google Play.</p>
        </div>
        <img src="/feature-graphic-1024x500.png" alt="Pulso: graba, transcribe y verifica" class="hero-image surface-card fade-up" />
      </section>

      <section class="features">
        <h2 class="section-title reveal">Todo lo que necesitas en una sola app</h2>
        <div class="feature-grid">
          <article class="feature-card surface-card reveal">
            <span class="feature-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
            </span>
            <h3>Graba con claridad</h3>
            <p>
              Captura entrevistas y reuniones con el micrófono de tu dispositivo y
              organízalas en proyectos y carpetas.
            </p>
          </article>

          <article class="feature-card surface-card reveal">
            <span class="feature-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            </span>
            <h3>Transcripción local</h3>
            <p>
              El audio se transcribe en tu propio dispositivo con Whisper.
              Tus grabaciones no salen de tu móvil.
            </p>
          </article>

          <article class="feature-card surface-card reveal">
            <span class="feature-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9Z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9Z"/></svg>
            </span>
            <h3>Verifica con IA</h3>
            <p>
              Un asistente contrasta tus transcripciones con tus fuentes usando
              inteligencia artificial (Gemini o Groq).
            </p>
          </article>

          <article class="feature-card surface-card reveal">
            <span class="feature-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10Z"/><path d="M12 13v7"/><path d="M8 16h8"/></svg>
            </span>
            <h3>Respalda en tu Drive</h3>
            <p>
              Sincroniza o exporta tu contenido a tu propia cuenta de Google
              Drive, solo cuando tú lo decidas.
            </p>
          </article>
        </div>
      </section>

      <section class="privacy surface-card reveal">
        <h2 class="section-title">Tus datos, en tu dispositivo</h2>
        <p>
          {appName} no usa anuncios ni herramientas de analítica de terceros.
          Tus grabaciones y transcripciones viven en tu dispositivo y solo tú
          decides si se respaldan en tu Drive.
        </p>
        <a href={legalUrls.privacy}>Política de privacidad</a>
      </section>
    </main>

    <Footer lastUpdated="06 de agosto de 2026" />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
