---
import "../styles/global.css";
import "../styles/landing.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Seo from "../components/Seo.astro";
import FeatureCard from "../components/FeatureCard.astro";
import { appName, tagline, description, guideUrl, faqUrl } from "../data/site.js";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <Seo
      title={`${appName} — Transcribir audio a texto y verificar con IA`}
      description="App para transcribir audio a texto en tu dispositivo, sin enviar el audio a la nube, y verificar datos con IA. Graba reuniones, clases o entrevistas."
    />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body>
    <Header headerTitle={appName} tagline={tagline} brandAs="p" />

    <main class="landing" id="main">
      <section class="hero">
        <div class="hero-content fade-up">
          <h1 class="hero-heading">Transcribe tus audios a texto sin que salgan de tu dispositivo.</h1>
          <p class="hero-description">{description}</p>
          <!-- Botón de descarga oculto hasta que la app esté publicada en Google Play:
          <a class="cta" href="#">Descargar en la tienda</a> -->
          <p class="hero-note">Disponible próximamente en Google Play.</p>
          <a class="guide-cta" href={guideUrl}>Consulta la guía de uso</a>
        </div>
      </section>

      <section class="privacy-first surface-card reveal">
        <h2 class="section-title">La privacidad no es una función, es el punto de partida</h2>
        <p class="privacy-lead">
          Protecciones activas por defecto, sin que tengas que configurar nada.
        </p>
        <div class="pillars-grid">
          <FeatureCard variant="row" title="Sin anuncios ni rastreadores" icon="shield">
            No usamos anuncios ni analítica de terceros, y no vendemos tus datos.
          </FeatureCard>

          <FeatureCard variant="row" title="Transcripción en tu dispositivo" icon="device">
            El audio se transcribe con Whisper en tu móvil y no se envía a
            servidores de transcripción.
          </FeatureCard>

          <FeatureCard variant="row" title="Base de datos cifrada" icon="lock">
            Tus proyectos, notas y transcripciones se guardan cifrados en tu
            dispositivo.
          </FeatureCard>

          <FeatureCard variant="row" title="Capturas bloqueadas" icon="camera-off">
            En Android, Pulso impide hacer capturas de pantalla de su contenido.
          </FeatureCard>
        </div>
        <p class="privacy-foot">
          Solo tú decides si tus datos se respaldan en tu Drive.
        </p>
      </section>

      <section class="features">
        <h2 class="section-title reveal">Todo lo que necesitas en una sola app</h2>
        <div class="feature-grid">
          <FeatureCard title="Graba con claridad" icon="mic">
            Captura clases, reuniones, entrevistas o notas de voz con el
            micrófono de tu dispositivo y organízalas en proyectos y carpetas.
          </FeatureCard>

          <FeatureCard title="Transcripción local" icon="edit">
            El audio se transcribe en tu propio dispositivo con Whisper.
            Tus grabaciones no se envían a servicios externos.
          </FeatureCard>

          <FeatureCard title="Verifica con IA" icon="sparkles">
            Contrasta datos y fragmentos de tus transcripciones con el
            asistente de IA y sus fuentes oficiales.
          </FeatureCard>

          <FeatureCard title="Importa tus audios" icon="file">
            Añade archivos .m4a, .mp3, .wav o .aac a tus proyectos. La
            importación está disponible con Pulso Premium.
          </FeatureCard>

          <FeatureCard title="Respalda en tu Drive" icon="cloud">
            Sincroniza o exporta tu contenido a tu propia cuenta de Google
            Drive, solo cuando tú lo decidas.
          </FeatureCard>
        </div>
      </section>

      <section class="faq-teaser">
        <h2 class="section-title reveal">
          <a href={faqUrl}>Preguntas frecuentes</a>
        </h2>
      </section>
    </main>

    <Footer />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
