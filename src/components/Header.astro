---
import { taglineFull } from "../data/site.js";

interface Props {
  headerTitle: string;
  effectiveDate: string;
}

const { headerTitle, effectiveDate } = Astro.props;
---

<header>
  <div class="header-brand">
    <img src="/icon.png" alt="Logotipo de Pulso" width="56" height="56" />
    <div class="header-text">
      <h1>{headerTitle}</h1>
      <p>{taglineFull}</p>
    </div>
  </div>
</header>