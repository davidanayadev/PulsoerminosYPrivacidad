---
import { tagline, taglineFull } from "../data/site.js";

interface Props {
  headerTitle: string;
  tagline?: string;
}

const { headerTitle, tagline: subtitle = taglineFull } = Astro.props;
---

<header>
  <a href="/" class="header-brand" aria-label="Volver al inicio">
    <img src="/icon.png" alt="Logotipo de Pulso" width="56" height="56" />
    <div class="header-text">
      <h1>{headerTitle}</h1>
      <p>{subtitle}</p>
    </div>
  </a>
</header>