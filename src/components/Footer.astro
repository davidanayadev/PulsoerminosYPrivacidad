---
import { appName, guideUrl, faqUrl, legalUrls } from "../data/site.js";

interface Props {
  lastUpdated?: string;
}

const { lastUpdated } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <nav aria-label="Navegación del sitio">
    <a href={legalUrls.home}>Inicio</a>
    <span aria-hidden="true">·</span>
    <a href={guideUrl}>Guía de uso</a>
    <span aria-hidden="true">·</span>
    <a href={faqUrl}>Preguntas frecuentes</a>
    <span aria-hidden="true">·</span>
    <a href={legalUrls.privacy}>Política de privacidad</a>
    <span aria-hidden="true">·</span>
    <a href={legalUrls.terms}>Términos y condiciones</a>
    <span aria-hidden="true">·</span>
    <a href={legalUrls.deletion}>Eliminación de datos</a>
  </nav>
  <div class="footer-brand">
    <img src="/icon.png" alt={appName} width="24" height="24" />
    <span class="footer-copyright">
      <span class="footer-c" aria-hidden="true">©</span>
      <span>{year}</span>
    </span>
    {lastUpdated && (
      <>
        <span aria-hidden="true">·</span>
        <span class="footer-updated">Última actualización: {lastUpdated}</span>
      </>
    )}
  </div>
</footer>
