---
import { appName, legalUrls } from "../data/site.js";

interface Props {
  lastUpdated: string;
}

const { lastUpdated } = Astro.props;
---

<footer>
  <span>{appName} — Última actualización: {lastUpdated}</span>
  <nav aria-label="Enlaces legales">
    <a href={legalUrls.privacy}>Política de privacidad</a>
    <span aria-hidden="true">·</span>
    <a href={legalUrls.terms}>Términos y condiciones</a>
    <span aria-hidden="true">·</span>
    <a href={legalUrls.deletion}>Eliminación de datos</a>
  </nav>
</footer>